{
  "spellright.language": [
    "en_US"
  ],
  "spellright.documentTypes": [
    "latex"
  ],
  "spellright.notificationClass": "hint",

  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "latexmk",
  "latex-workshop.latex.outDir": "%DIR%/build",

  "latex-workshop.latex.path": "C:\\Users\\Administrator\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "C:\\Users\\Administrator\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\latexmk.exe",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-f",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Users\\Administrator\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64;C:\\Strawberry\\perl\\bin;%PATH%"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    }
  ],

  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.view.pdf.internal.synctex.keybinding": "ctrl-click",

  "files.associate": {
    "*.tex": "latex"
  },

  "[latex]": {
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "same"
  }
}
